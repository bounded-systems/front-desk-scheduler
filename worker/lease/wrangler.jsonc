{
  // front-desk-lease — the scheduler's serialization point (A2).
  //
  // Deploy:  npx wrangler deploy      (from worker/lease/)
  //
  // Then set the repo variable so claim-race can actually measure production:
  //   gh variable set FDS_CLAIM_ENDPOINT -R bounded-systems/front-desk-scheduler \
  //      -b "https://front-desk-lease.<subdomain>.workers.dev"
  //
  // Turning `production-a2` green is the acceptance criterion for this Worker
  // (docs/queue-vs-log.md). Deploying it is not the same as discharging A2 —
  // that takes N agents racing the real endpoint with exactly one grant.
  //
  // NO SECRET LIVES HERE. This Worker holds no credential: it stores lease state
  // and hands out fencing tokens. Writes are authenticated by VALIDATING a
  // GitHub token the caller already holds (see AUTH_MODE below and
  // "Authentication" in README.md) — not by copying the broker's OIDC pins. The
  // broker authenticates WORKFLOWS (job_workflow_ref@refs/heads/main) and a
  // claimant is often an interactive agent, a different caller shape; widening
  // the broker's trust boundary to cover it would have been the easy wrong move.
  "name": "front-desk-lease",
  "main": "src/index.mjs",
  "compatibility_date": "2026-06-21",
  // STAYS ON during the custom-domain migration below: the FDS_CLAIM_ENDPOINT
  // repo variable (lease-deploy's output) may still name
  // front-desk-lease.titular-0-kicks.workers.dev, and turning this off first
  // would break every claimant at once. Retire it only after the last consumer
  // points at lease.bounded.tools. The dialog's copy of FDS_CLAIM_ENDPOINT is
  // no longer a consumer to wait for: it was retired 2026-08-16
  // (.github-private#494 item 4) — session delivery moved to .mcp.json and
  // .claude/settings.json, both already pointing at lease.bounded.tools.
  "workers_dev": true,
  // lease.bounded.tools — added 2026-08-10. The custom domain is part of the
  // deploy, deliberately: `wrangler deploy` reconciles the hostname binding on
  // every run, so the endpoint's identity is version-controlled and moves
  // through the same approval-gated lane as the code (full rationale in infra →
  // cloudflare/status/wrangler.jsonc; boot and status prove the lane's minted
  // token can attach domains). Sessions then reach the claim endpoint under
  // *.bounded.tools, which the shared dialog already allowlists — so the
  // workers.dev entry can eventually leave the dialog and the org's trust
  // surface stops naming a generated Cloudflare account slug.
  "routes": [
    {
      "pattern": "lease.bounded.tools",
      "custom_domain": true
    }
  ],
  // Don't leave old versions of the exclusion mechanism publicly reachable: a
  // stale preview backed by its own DO namespace is a SECOND serialization
  // point, which is precisely the failure this Worker exists to remove.
  "preview_urls": false,
  "vars": {
    // Auth for WRITES (claim/renew/release): "github" validates the caller's
    // GitHub token against the repo (push permission for user tokens,
    // installation coverage for App/Actions tokens) and namespaces the agent
    // under the verified identity. Unset defaults to "github" in code — the
    // fail-closed direction. Set "none" ONLY for a scratch deployment where
    // unauthenticated claims are an accepted property; putting that word here
    // is what makes the acceptance reviewable.
    "AUTH_MODE": "github",
    "ALLOWED_REPO": "bounded-systems/front-desk-scheduler"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LEASE",
        "class_name": "LeaseObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LeaseObject"]
    }
  ]
}
