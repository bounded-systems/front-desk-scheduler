# SHACL shapes for Front Desk mirror items — the declarative twin of the
# enforcement stack, one layer per mechanism:
#
#   column constraints (Dolt ENUM/CHECK/FK)  → sh:in / sh:minInclusive / sh:class
#   cross-row SQL checks (mirror shapeChecks) → sh:sparql shapes below
#   scheduler invariants (S1..L2, proven)     → the semantics these shapes guard
#
# Validation target: the mirror rendered as RDF (one fd:Item per items row,
# fd:dependsOn edges from item_deps) — `scripts/shacl_validate.py` is the
# renderer, and `specs/shacl/fixtures/` pins what these shapes accept and reject.
# Wiring to conformance-kit's shared runner is #3, blocked on conformance-kit#58.
#
# TWO REQUIREMENTS ON ANY RENDERER (#139)
# ---------------------------------------
# These shapes are not renderer-agnostic. A renderer that does not meet both
# produces a WRONG verdict rather than an error, so read this before writing a
# second one (a JSON-LD path for conformance-kit would be the first case):
#
#   1. Emit a reflexive `fd:self` edge on every item. Core SHACL cannot compare a
#      property's values against the focus node, so `sh:disjoint fd:self` below
#      relies on it being materialised. Omit it and the self-dependency check
#      SILENTLY passes everything — the constraint is vacuously true, not broken,
#      so nothing reports it.
#   2. Type `fd:effort`/`fd:value` as `xsd:double` explicitly. Plain Turtle `2.0`
#      parses as `xsd:decimal` and fails `sh:datatype`, so a CLEAN item reports
#      violations that look like bad data rather than a bad rendering.
#   3. Emit `fd:origin` on every item ("github" | "dolt", the mirror's NOT NULL
#      enum). `fd:number` is required exactly when the item is github-origin
#      (#143), and that conditional is expressed as a SPARQL shape over
#      fd:origin. Unlike fd:self this one fails LOUD if omitted — sh:minCount 1
#      on fd:origin reports the missing property — so a renderer that skips it
#      reds the lane rather than silently passing numberless github rows.
#
# The fixtures are what keep both honest: fixtures/clean.ttl must conform,
# fixtures/violations.ttl must NOT, and `npm run shacl:fixtures` asserts both.

@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix fd:   <https://bounded.tools/ns/front-desk#> .

# SHACL-SPARQL requires a SPARQL-based constraint to declare its own prefixes —
# the @prefix lines above are Turtle syntax and do not reach inside a sh:select
# string. pyshacl resolves them from the shapes graph anyway, so this changes
# nothing on the current path; a spec-strict engine refuses without it
# (shacl-engine 1.1.2: `Error: Unknown prefix: fd`). Declared so the file is
# portable to whichever runner #3 lands on.
fd:prefixes
  sh:declare [
    sh:prefix "fd" ;
    sh:namespace "https://bounded.tools/ns/front-desk#"^^xsd:anyURI ;
  ] .

fd:ItemShape
  a sh:NodeShape ;
  sh:targetClass fd:Item ;
  sh:property [
    # OPTIONAL by decision (#143): fd:number is the GitHub issue/PR number, so
    # it exists iff the item is github-origin. Dolt-born hidden items
    # (`dolt:<local>` ids, scripts/hidden.ts) legitimately have none until
    # captured, and the mirror column is nullable for exactly that reason.
    # "Required when github-origin" lives in fd:GithubIdentityShape below —
    # a blanket sh:minCount 1 here would call a legal board state corruption.
    sh:path fd:number ;
    sh:datatype xsd:integer ; sh:minInclusive 1 ;
    sh:minCount 0 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    # Mirror column `origin` enum('github','dolt') NOT NULL — renderer
    # requirement 3 in the header. minCount 1 is what keeps
    # fd:GithubIdentityShape from going vacuous on a renderer that omits it.
    sh:path fd:origin ;
    sh:in ( "github" "dolt" ) ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path fd:status ;
    sh:in ( "Todo" "In Progress" "Blocked" "Done" ) ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path fd:kind ;
    sh:in ( "epic" "room" "door" "task" ) ;
    sh:minCount 1 ; sh:maxCount 1 ;
  ] ;
  sh:property [
    sh:path fd:effort ;
    # xsd:double is a RENDERER REQUIREMENT, not a preference — see the header.
    sh:datatype xsd:double ; sh:minInclusive 0 ; sh:maxInclusive 10 ;
  ] ;
  sh:property [
    sh:path fd:value ;
    sh:datatype xsd:double ; sh:minInclusive 0 ; sh:maxInclusive 100 ;
  ] ;
  sh:property [
    sh:path fd:dependsOn ;
    sh:class fd:Item ;         # referential integrity (mirror: FK fk_dep_dst)
    # No self-dependency (mirror: chk_no_self_dep). REQUIRES the renderer to
    # emit `fd:self` — see the header. Vacuously true without it.
    sh:disjoint fd:self ;
  ] .

# The conditional half of the #143 decision: a GITHUB-origin item without a
# number IS corruption — the syncer writes `number` on every github row it
# upserts and drops draft/numberless content at normalize (src/board.ts), so a
# github row with NULL number means the mirror lost the item's identity.
# sh:Violation deliberately: this is the case the old blanket minCount 1 was
# actually guarding, kept at full severity now that the legal absence is legal.
fd:GithubIdentityShape
  a sh:NodeShape ;
  sh:targetClass fd:Item ;
  sh:severity sh:Violation ;
  sh:sparql [
    sh:prefixes fd:prefixes ;
    sh:message "GitHub-origin item has no fd:number — mirror identity lost" ;
    sh:select """
      SELECT $this WHERE {
        $this fd:origin "github" .
        FILTER NOT EXISTS { $this fd:number ?n }
      }""" ;
  ] .

# D2 — a Blocked item must have at least one non-Done dependency (justified block).
fd:BlockedJustifiedShape
  a sh:NodeShape ;
  sh:targetClass fd:Item ;
  sh:severity sh:Warning ;
  sh:sparql [
    sh:prefixes fd:prefixes ;
    sh:message "Blocked item has no open dependency recorded" ;
    sh:select """
      SELECT $this WHERE {
        $this fd:status "Blocked" .
        FILTER NOT EXISTS {
          $this fd:dependsOn ?dep .
          ?dep fd:status ?s . FILTER (?s != "Done")
        }
      }""" ;
  ] .

# D3 — a Todo item with an open dependency should be Blocked (bd-ready agreement).
fd:ReadyAgreementShape
  a sh:NodeShape ;
  sh:targetClass fd:Item ;
  sh:severity sh:Warning ;
  sh:sparql [
    sh:prefixes fd:prefixes ;
    sh:message "Todo item has open dependencies (should be Blocked)" ;
    sh:select """
      SELECT $this WHERE {
        $this fd:status "Todo" ; fd:dependsOn ?dep .
        ?dep fd:status ?s . FILTER (?s != "Done")
      }""" ;
  ] .

# D1 — acyclicity (scheduler invariant L1's data precondition). SHACL-SPARQL can
# express bounded-depth cycle detection via property paths:
fd:AcyclicShape
  a sh:NodeShape ;
  sh:targetClass fd:Item ;
  sh:severity sh:Violation ;
  sh:sparql [
    sh:prefixes fd:prefixes ;
    sh:message "Item participates in a dependency cycle — can never become Ready" ;
    sh:select """
      SELECT $this WHERE { $this fd:dependsOn+ $this }""" ;
  ] .
